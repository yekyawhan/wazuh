<Sysmon schemaversion="4.50">
  <!-- siem1 Noise-Reduced + Detection-Focused Configuration
       Based on 24h alerts.json analysis (2026-10-05)
       Generated by Laypyay / LAYPYAY Core
       Deployment: Phase 1 - WIN11-TESTBOX CYS-06 (agent 002) -->
  <HashAlgorithms>sha256</HashAlgorithms>
  <CheckRevocation/>
  <!-- Review notes:
       - Exact-path EID1 exclusions preserved; unknown copies remain visible.
       - EID3 Microsoft hostname blanket exclusion removed to prevent C2 blind spots.
       - EID8 winlogon exclusion uses SourceImage.
       - EID11 webroot + common webshell extensions retained.
       - EID12 broad CreateKey exclusion removed.
       - EID22 remains targeted; full DNS logging is intentionally disabled. -->

  <EventFiltering>

    <!-- ============================================================
         ID 1: ProcessCreate - Exact Path Noise Reduction
         Principle: Known-good exact path - exclude
                    Same executable from unknown path - KEEP LOGGING
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">

        <!-- Docker CLI - exact installed path only -->
        <Image condition="is">C:\Program Files\Docker\Docker\resources\bin\docker.exe</Image>
        <!-- 15,889 hits/day | parent: (empty) | exact binary only -->

        <!-- Google Updater - exact observed versioned path -->
        <Image condition="is">C:\Program Files (x86)\Google\GoogleUpdater\156.0.8067.0\updater.exe</Image>
        <!-- 8,061 hits/day | parent: (empty) | version-specific path -->

        <!-- Windows Task Host -->
        <Image condition="is">C:\Windows\System32\taskhostw.exe</Image>
        <!-- 6,194 hits/day | parent: (empty) | scheduled task host -->

        <!-- Windows Audit Policy utility -->
        <Image condition="is">C:\Windows\SysWOW64\auditpol.exe</Image>
        <!-- 4,644 hits/day | parent: (empty) | legitimate auditing -->

        <!-- NVIDIA SMI - exact system path -->
        <Image condition="is">C:\Windows\System32\nvidia-smi.exe</Image>
        <!-- 6,417 hits/day | parent: (empty) | GPU monitoring -->

        <!-- Windows Task List -->
        <Image condition="is">C:\Windows\System32\tasklist.exe</Image>
        <!-- 6,771 hits/day | parent: (empty) | process enumeration -->

        <!-- Windows Error Reporting -->
        <Image condition="is">C:\Windows\System32\wermgr.exe</Image>
        <!-- 1,103 hits/day | parent: (empty) -->
        <Image condition="is">C:\Windows\System32\WerFault.exe</Image>
        <!-- 1,021 hits/day | parent: (empty) -->

        <!-- Windows Update / USO Worker -->
        <Image condition="is">C:\Windows\UUS\amd64\MoUsoCoreWorker.exe</Image>
        <!-- 1,349 hits/day | parent: (empty) -->
        <Image condition="is">C:\Windows\servicing\TrustedInstaller.exe</Image>
        <!-- 746 hits/day | parent: (empty) -->

        <!-- EdgeWebView2 - exact observed versioned paths (multiple versions) -->
        <Image condition="is">C:\Program Files (x86)\Microsoft\EdgeWebView\Application\154.0.4258.53\msedgewebview2.exe</Image>
        <!-- 3,334 hits/day -->
        <Image condition="is">C:\Program Files (x86)\Microsoft\EdgeWebView\Application\154.0.4258.62\msedgewebview2.exe</Image>
        <!-- 301 hits/day -->
        <Image condition="is">C:\Program Files (x86)\Microsoft\EdgeWebView\Application\153.0.4234.48\msedgewebview2.exe</Image>
        <!-- 280 hits/day -->
        <!-- Note: specific versions only; user-writable copies NOT excluded -->

        <!-- Microsoft Edge Update -->
        <Image condition="is">C:\Program Files (x86)\Microsoft\EdgeUpdate\MicrosoftEdgeUpdate.exe</Image>
        <!-- 1,404 hits/day | parent: (empty) -->

        <!-- Conexant SmartAudio (HP audio driver) - both observed paths -->
        <Image condition="is">C:\Program Files\CONEXANT\SA3\HP-NB-AIO\SmartAudio3.exe</Image>
        <!-- 3,256 hits/day -->
        <Image condition="is">C:\Program Files\Conexant\SA3\HP-NB-AIO\SmartAudio3.exe</Image>
        <!-- 769 hits/day -->

        <!-- HP Enabling Services -->
        <Image condition="is">C:\Program Files\HP\HP Enabling Services\ServiceCoordinator.exe</Image>
        <!-- 707 hits/day -->
        <Image condition="is">C:\Program Files\HP\HP Enabling Services\DiagsCap.exe</Image>
        <!-- 706 hits/day -->

        <!-- OneDrive FileCoAuth - exact observed user/version path -->
        <Image condition="is">C:\Users\user\AppData\Local\Microsoft\OneDrive\26.168.0830.0006\FileCoAuth.exe</Image>
        <!-- 1,180 hits/day | user-specific versioned path -->

        <!-- Atlassian SourceTree git_local - exact user profile paths -->
        <Image condition="is">C:\Users\Poe Phyu Thae\AppData\Local\Atlassian\SourceTree\git_local\mingw64\libexec\git-core\git.exe</Image>
        <!-- 1,945 hits/day -->
        <Image condition="is">C:\Users\Poe Phyu Thae\AppData\Local\Atlassian\SourceTree\git_local\cmd\git.exe</Image>
        <!-- 196 hits/day -->
        <Image condition="is">C:\Users\Poe Phyu Thae\AppData\Local\Atlassian\SourceTree\git_local\mingw64\bin\git.exe</Image>
        <!-- 196 hits/day -->

        <!-- Windows Defender MpCmdRun - exact platform versioned path -->
        <Image condition="is">C:\ProgramData\Microsoft\Windows Defender\Platform\4.18.26080.4-0\MpCmdRun.exe</Image>
        <!-- 624 hits/day | version-specific -->

        <!-- Microsoft Office SDXHelper -->
        <Image condition="is">C:\Program Files\Microsoft Office\root\Office16\SDXHelper.exe</Image>
        <!-- 731 hits/day -->

        <!-- Git for Windows - exact Program Files paths only (NOT user-writable copies) -->
        <Image condition="is">C:\Program Files\Git\mingw64\bin\git.exe</Image>
        <!-- 2,462 hits/day -->
        <Image condition="is">C:\Program Files\Git\cmd\git.exe</Image>
        <!-- 2,232 hits/day -->
        <Image condition="is">C:\Program Files\Git\bin\git.exe</Image>
        <!-- 229 hits/day -->
        <Image condition="is">C:\Program Files\Git\mingw64\libexec\git-core\git.exe</Image>
        <!-- 210 hits/day -->
        <!-- User-writable Hermes Git copies (C:\Users\AGB\AppData\Local\hermes\tools\git-*) NOT excluded -->

        <!-- Browser renderer subprocesses - installation path + -type= pattern -->
        <!-- Chrome -->
        <CommandLine condition="begin with">&quot;C:\Program Files\Google\Chrome\Application\chrome.exe&quot; --type=</CommandLine>
        <CommandLine condition="begin with">&quot;C:\Program Files (x86)\Google\Chrome\Application\chrome.exe&quot; --type=</CommandLine>
        <!-- Edge -->
        <CommandLine condition="begin with">&quot;C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe&quot; --type=</CommandLine>
        <!-- Firefox -->
        <CommandLine condition="begin with">&quot;C:\Program Files\Mozilla Firefox\firefox.exe&quot; -contentproc</CommandLine>
        <!-- Brave -->
        <CommandLine condition="begin with">&quot;C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe&quot; --type=</CommandLine>

        <!-- Core Windows system noise (from base config) -->
        <Image condition="is">C:\Windows\system32\conhost.exe</Image>
        <Image condition="is">C:\Windows\system32\audiodg.exe</Image>
        <Image condition="is">C:\Windows\system32\CompatTelRunner.exe</Image>
        <CommandLine condition="begin with">C:\Windows\system32\DllHost.exe /Processid</CommandLine>
        <CommandLine condition="begin with">C:\Windows\system32\wbem\wmiprvse.exe -Embedding</CommandLine>

      </ProcessCreate>
    </RuleGroup>

    <!-- ============================================================
         ID 1: ProcessCreate - Office - LOLBin Chain Detection
         Preserve telemetry for Wazuh correlation (no exclusion here)
         Detection logic moved to Wazuh rules:
         ParentImage - {winword.exe, excel.exe, powerpnt.exe, outlook.exe}
         AND Image - {powershell.exe, cmd.exe, wscript.exe, cscript.exe, mshta.exe, rundll32.exe}
         ============================================================ -->
    <!-- NO exclusions added here - all Office-script chains preserved for correlation -->

    <!-- ============================================================
         ID 3: NetworkConnect - Attack-Relevant Network Activity
         Preserve existing logic, add proxy ports
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image name="Usermode" condition="begin with">C:\Users</Image>
        <Image name="Suspicious" condition="begin with">C:\ProgramData</Image>
        <Image name="Suspicious" condition="begin with">C:\Windows\Temp</Image>
        <Image condition="image">powershell.exe</Image>
        <Image condition="image">cmd.exe</Image>
        <Image condition="image">certutil.exe</Image>
        <Image condition="image">bitsadmin.exe</Image>
        <Image condition="image">mshta.exe</Image>
        <Image condition="image">rundll32.exe</Image>
        <Image condition="image">regsvr32.exe</Image>
        <Image condition="image">wscript.exe</Image>
        <Image condition="image">cscript.exe</Image>
        <Image condition="image">msiexec.exe</Image>
        <Image condition="image">psexec.exe</Image>
        <Image condition="image">nc.exe</Image>
        <Image condition="image">ncat.exe</Image>
        <DestinationPort name="RDP" condition="is">3389</DestinationPort>
        <DestinationPort name="SSH" condition="is">22</DestinationPort>
        <DestinationPort name="Telnet" condition="is">23</DestinationPort>
        <DestinationPort name="Metasploit" condition="is">4444</DestinationPort>
        <DestinationPort name="SMTP" condition="is">25</DestinationPort>
        <DestinationPort name="Proxy-1080" condition="is">1080</DestinationPort>
        <DestinationPort name="Proxy-3128" condition="is">3128</DestinationPort>
        <DestinationPort name="Proxy-8080" condition="is">8080</DestinationPort>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <DestinationIp condition="begin with">fe80:</DestinationIp>
      </NetworkConnect>
    </RuleGroup>

    <!-- ============================================================
         ID 6: DriverLoad - Non-Microsoft drivers only
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <DriverLoad onmatch="exclude">
        <Signature condition="contains">microsoft</Signature>
        <Signature condition="contains">windows</Signature>
      </DriverLoad>
    </RuleGroup>

    <!-- ============================================================
         ID 7: ImageLoad - OFF (empty include filter = no ImageLoad events)
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include"></ImageLoad>
    </RuleGroup>

    <!-- ============================================================
         ID 8: CreateRemoteThread - Injection detection
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <SourceImage condition="is">C:\Windows\system32\wbem\WmiPrvSE.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\svchost.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\csrss.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\services.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\winlogon.exe</SourceImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- ============================================================
         ID 9: RawAccessRead - OFF (empty include filter = no RawAccessRead events)
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <RawAccessRead onmatch="include"></RawAccessRead>
    </RuleGroup>

    <!-- ============================================================
         ID 11: FileCreate - Staging + Persistence + Webshell
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="Startup" condition="contains">\Startup\</TargetFilename>
        <TargetFilename name="Downloads" condition="contains">\Downloads\</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.sys</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.cmd</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.hta</TargetFilename>
        <TargetFilename condition="end with">.docm</TargetFilename>
        <TargetFilename condition="end with">.xlsm</TargetFilename>
        <TargetFilename name="ScheduledTask" condition="begin with">C:\Windows\system32\Tasks</TargetFilename>
        <!-- Webroot paths for webshell detection -->
        <TargetFilename name="IIS-Webroot" condition="begin with">C:\inetpub\wwwroot\</TargetFilename>
        <TargetFilename name="XAMPP-Webroot" condition="begin with">C:\xampp\htdocs\</TargetFilename>
        <!-- Common webshell/script extensions -->
        <TargetFilename condition="end with">.aspx</TargetFilename>
        <TargetFilename condition="end with">.ashx</TargetFilename>
        <TargetFilename condition="end with">.asmx</TargetFilename>
        <TargetFilename condition="end with">.jsp</TargetFilename>
        <TargetFilename condition="end with">.jspx</TargetFilename>
        <TargetFilename condition="end with">.php</TargetFilename>
        <TargetFilename condition="end with">.php5</TargetFilename>
      </FileCreate>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="exclude">
        <TargetFilename condition="begin with">C:\Windows\Installer\</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\winsxs\</TargetFilename>
        <Image condition="is">C:\Windows\system32\smss.exe</Image>
      </FileCreate>
    </RuleGroup>

    <!-- ============================================================
         ID 12/13/14: RegistryEvent - Persistence + Tampering
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject name="RunKey" condition="contains">CurrentVersion\Run</TargetObject>
        <TargetObject name="Winlogon" condition="contains">CurrentVersion\Winlogon\</TargetObject>
        <TargetObject name="IFEO" condition="contains">Image File Execution Options\</TargetObject>
        <TargetObject name="Service" condition="end with">\ImagePath</TargetObject>
        <TargetObject name="Service" condition="end with">\ServiceDll</TargetObject>
        <TargetObject name="RDP" condition="end with">fDenyTSConnections</TargetObject>
        <TargetObject name="Tamper-Defender" condition="end with">DisableAntiSpyware</TargetObject>
        <TargetObject name="Tamper-Defender" condition="end with">DisableRealtimeMonitoring</TargetObject>
        <TargetObject name="Tamper-Defender" condition="contains">Windows Defender\Exclusions\</TargetObject>
        <TargetObject name="Tamper-Firewall" condition="end with">\EnableFirewall</TargetObject>
        <TargetObject name="UAC" condition="end with">\EnableLUA</TargetObject>
        <TargetObject name="LSA" condition="begin with">HKLM\SYSTEM\CurrentControlSet\Control\Lsa\</TargetObject>
        <TargetObject name="COM-Hijack" condition="end with">\InprocServer32\(Default)</TargetObject>
      </RegistryEvent>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <!-- Narrow exclusions only; do not suppress all CreateKey events. -->
        <TargetObject condition="end with">HKLM\SYSTEM\CurrentControlSet\Control\Lsa\LsaPid</TargetObject>
        <TargetObject condition="end with">HKLM\SYSTEM\CurrentControlSet\Control\Lsa\SspiCache</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- ============================================================
         ID 17/18: PipeEvent - C2 / Lateral Movement
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName condition="contains any">paexec;remcom;csexec;\lsadump;\cachedump;\wceservicepipe</PipeName>
        <PipeName condition="contains all">MSSE-;-server</PipeName>
        <PipeName condition="begin with">\postex_</PipeName>
        <PipeName condition="begin with">\msagent_</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- ============================================================
         ID 19/20/21: WMI - All WMI events (high-volume; retained for current pilot)
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude"></WmiEvent>
    </RuleGroup>

    <!-- ============================================================
         ID 22: DNS - Targeted Suspicious Telemetry
         NOT full DNS logging; only suspicious TLDs/services
         Correlation: Wazuh rules join DNS + Process + NetworkConnect
         ============================================================ -->
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="include">
        <QueryName name="Freenom-TK" condition="end with">.tk</QueryName>
        <QueryName name="Freenom-GA" condition="end with">.ga</QueryName>
        <QueryName name="Freenom-ML" condition="end with">.ml</QueryName>
        <QueryName name="Dynamic-DuckDNS" condition="contains">duckdns.org</QueryName>
        <QueryName name="Tunnel-Ngrok" condition="contains">ngrok.io</QueryName>
        <QueryName name="Tunnel-Ngrok" condition="contains">ngrok-free.app</QueryName>
        <QueryName name="Tunnel-Serveo" condition="contains">serveo.net</QueryName>
        <QueryName name="Tunnel-Localhost" condition="contains">loca.lt</QueryName>
        <QueryName name="Tunnel-PageKite" condition="contains">pagekite.me</QueryName>
      </DnsQuery>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
