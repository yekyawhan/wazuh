    "jsCode": "const wrapper = $input.first().json;\nconst raw = wrapper.body && wrapper.body.rule ? wrapper.body : wrapper;\nconst a = raw.agent || {};\nconst r = raw.rule || {};\nconst d = raw.data || {};\nconst al = d.alert || raw.alert || {};\nconst srcIp = d.srcip || al.src_ip || 'N/A';\nconst dstIp = d.dstip || al.dest_ip || 'N/A';\nconst dstPort = (d.dstport || al.dest_port || 'N/A').toString();\nconst sig = al.signature || raw.description || r.description || 'unknown';\nconst action = al.action || d.action || 'alerted';\nconst ruleId = String(r.id || '');\nconst agentId = String(a.id || '');\nconst KIB = 'https://10.3.11.40:5601';\nconst filters = \"(key:!(\\'rule.id\\'),meta:(index:\\'wazuh-alerts-4.x-*\\',key:\\'rule.id\\',value:\\'\" + ruleId + \"\\',type:phrase),query:(match_phrase:(\\'rule.id\\':\\'\" + ruleId + \"\\')))\";\nconst disc = \"_a=(columns:!(rule.id,data.srcip,rule.description),filters:!(\" + filters + \"),index:%27[wazuh-alerts-4.x-]*%27,interval:auto,query:(language:kuery,query:%27%27),time:(from:now-24h,to:now)),_g=(time:(from:now-24h,to:now))\";\nconst kibanaAlertUrl = KIB + '/app/discover#/?' + disc;\nconst agentUrl = KIB + '/app/wazuh#/agents-preview/overview/' + (agentId || '');\nconst n8nRunUrl = 'http://10.3.11.40:5678/workflow/3x3QqoFaHDcxnI0c/executions';\nreturn [{ json: {\n  alert: raw, ruleId,\n  ruleLevel: r.level || 0,\n  agentId, agentName: a.name || 'unknown',\n  srcIp, dstIp, dstPort, sig, action,\n  kibanaAlertUrl, agentUrl, n8nRunUrl,\n  isCritical: (r.level || 0) >= 13\n}}];"
   },
