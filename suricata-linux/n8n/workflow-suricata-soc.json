{
  "name": "Suricata IPS SOC",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "suricata-soc",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "suricata-soc",
      "id": "87b72f45-2bc1-4966-9fda-629bc5560558"
    },
    {
      "parameters": {
        "jsCode": "const wrapper = $input.first().json;\n// Wazuh integration POSTs the alert; n8n webhook wraps it under `body`\nconst alert = wrapper.body && wrapper.body.rule ? wrapper.body : wrapper;\nconst allowedRules = ['100160', '100161', '100162', '100170', '100171', '100175'];\nconst ruleId = String(alert.rule?.id || alert.id || '');\n\nif (!allowedRules.includes(ruleId)) {\n  return [];\n}\n\nconst agentName = alert.agent?.name || 'unknown';\nconst ruleLevel = Number(alert.rule?.level || 0);\nconst ruleDesc = alert.rule?.description || 'Suricata alert';\nconst data = alert.data || {};\nconst srcIp = data.src_ip || 'N/A';\nconst dstIp = data.dest_ip || 'N/A';\nconst dstPort = data.dest_port || 'N/A';\nconst sig = data.alert?.signature || ruleDesc;\nconst action = data.alert?.action || 'alert';\n\nreturn [{\n  json: {\n    alert,\n    ruleId,\n    ruleLevel,\n    agentName,\n    srcIp,\n    dstIp,\n    dstPort,\n    sig,\n    action,\n    isCritical: ruleLevel >= 13 || ['100160', '100161', '100162', '100170', '100175'].includes(ruleId)\n  }\n}];"
      },
      "name": "Filter and Enrich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "id": "50ec5c88-217a-447c-885f-509fdb4d6471"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst key = `${item.srcIp}_${item.ruleId}`;\nconst now = Date.now();\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.dedupe = staticData.dedupe || {};\n\nconst lastSeen = staticData.dedupe[key];\n// Dedupe for 24 hours (86400000 ms)\nif (lastSeen && (now - lastSeen < 86400000)) {\n  return [];\n}\n\nstaticData.dedupe[key] = now;\nreturn [{ json: item }];"
      },
      "name": "24h Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "id": "877038b1-36a3-42f5-ac1e-6201aba2e27e"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isCritical }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Severity Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "id": "9b07e599-f020-41de-88d2-c94c647d0ce0"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "-1004301734497",
        "text": "={{ '\ud83d\udd34 <b>[SURICATA IPS ALERT]</b>\\n' + '<b>Type:</b> ' + ($json.ruleId === '100170' ? 'PACKET DROP (NFQUEUE)' : 'HOST AUTO-BLOCK (AR)') + '\\n' + '<b>Rule ID:</b> ' + $json.ruleId + ' (Level ' + $json.ruleLevel + ')' + '\\n' + '<b>Agent:</b> ' + $json.agentName + '\\n' + '<b>Attacker:</b> <code>' + $json.srcIp + '</code>\\n' + '<b>Target:</b> <code>' + $json.dstIp + ':' + $json.dstPort + '</code>\\n' + '<b>Signature:</b> ' + $json.sig + '\\n' + '<b>Action:</b> ' + $json.action }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "eCt4h9eYogj45d07",
          "name": "Telegram account"
        }
      },
      "id": "a5e66c53-350e-4529-b620-2833f715a5e2",
      "webhookId": "8fc5f174-0feb-4f36-87ab-18a73229f58c"
    },
    {
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "0ARlCwjbJIHA8E2Q"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.alert.timestamp || $json.alert.rule?.description ? new Date().toISOString() : '' }}",
            "rule_id": "={{ $json.ruleId }}",
            "rule_level": "={{ $json.ruleLevel }}",
            "agent_name": "={{ $json.agentName }}",
            "src_ip": "={{ $json.srcIp }}",
            "dst_ip": "={{ $json.dstIp }}",
            "dst_port": "={{ String($json.dstPort) }}",
            "signature": "={{ $json.sig }}",
            "action": "={{ $json.action }}",
            "created_at": "={{ new Date().toISOString() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "name": "Log to Events Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        900,
        480
      ],
      "onError": "continueRegularOutput",
      "id": "4fc55d2d-9c70-42c7-b9d5-2a94bc2a5d6c"
    }
  ],
